# ServiceNow instance
SERVICENOW_INSTANCE_URL=https://yourcompany.service-now.com
SERVICENOW_BASIC_USERNAME=your_username
SERVICENOW_BASIC_PASSWORD=your_password

# Optional: transport mode for containerized (network) use
# TRANSPORT=http
# PORT=3000
# HOST=0.0.0.0

# Optional: require a bearer token for HTTP access (recommended when exposed)
# NOWAIKIT_API_KEY=change-me-to-a-long-random-secret
# CORS_ORIGIN=https://your-client.example.com
